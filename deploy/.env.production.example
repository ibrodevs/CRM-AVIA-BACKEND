# Copy to repository root as .env and replace every CHANGE_ME value.
# Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# Public backend hostname, without protocol.
DJANGO_ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
SECURE_SSL_REDIRECT=True

# Frontend origin. Keep the API closed to unknown browser origins in production.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://crm.example.com

BUSINESS_TIMEZONE=Asia/Bishkek
BASE_CURRENCY=USD
ALLOW_MOCK_ADAPTER=False
LOG_LEVEL=INFO

# PostgreSQL. Use a long hexadecimal password so it is safe inside DATABASE_URL.
POSTGRES_DB=travelhub
POSTGRES_USER=travelhub
POSTGRES_PASSWORD=CHANGE_ME_HEX_PASSWORD
DATABASE_URL=postgres://travelhub:CHANGE_ME_HEX_PASSWORD@db:5432/travelhub
DB_CONN_MAX_AGE=60

# Docker/Gunicorn settings for the initial 2 vCPU / 4 GB server.
APP_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=90

# Background jobs.
JOB_BATCH_SIZE=10
JOB_HEARTBEAT_SECONDS=30
JOB_STALE_AFTER_SECONDS=180
JOB_DEFAULT_MAX_ATTEMPTS=5
JOB_POLL_INTERVAL_SECONDS=1.0
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BATCH_SIZE=100

# Hotelbook / HB Pro Expert.
# SupplierCredential stored in CRM remains preferred; these values are only the
# backend fallback/diagnostic credentials when explicitly enabled.
HBPRO_LOGIN=
HBPRO_PASSWORD=
HBPRO_LOCALE=ru
HBPRO_DEFAULT_CITIZENSHIP=KG
HBPRO_PAY_FORM=CASHLESS
HBPRO_ALLOW_ENV_FALLBACK=False

# Optional outbound channels. Leave blank until configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
MAX_API_URL=
MAX_API_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_SENDER=
WEBHOOK_SECRETS=
